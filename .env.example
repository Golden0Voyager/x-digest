# =================================================================
# 1. 基础网络配置 (国内访问必填)
# =================================================================
# 保障爬虫访问 x.com 及调用海外 API 端点
# 注意：端口号 (如 8118, 7890, 1080) 需根据您本地代理软件的实际设置修改
PROXY=http://127.0.0.1:7897

# =================================================================
# 2. AI 供应商与模型降级链
# =================================================================
# 第一个配置了 Key 的供应商作为翻译/洞察首选；显式链可跨供应商交错。
AI_PROVIDER_CHAIN=OPENROUTER,SENSENOVA
AI_MODEL=baidu/ernie-5.5-flash-preview:free
AI_MODEL_TRANSLATE=baidu/ernie-5.5-flash-preview:free
AI_MODEL_INSIGHTS=baidu/ernie-5.5-flash-preview:free

# 每次失败换一个模型，交替供应商以分散免费端点 RPM 压力。
AI_FALLBACK_CHAIN=SENSENOVA:deepseek-flash,OPENROUTER:nvidia/nemotron-3.5-super-vl:free,SENSENOVA:sensenova-6.8-flash-lite,OPENROUTER:nvidia/nemotron-3.5-lightning:free,SENSENOVA:sensenova-6.8-flash
# 按模型 ID 覆盖输出上限；未列出的模型使用调用方默认值。
AI_MODEL_MAX_TOKENS={"baidu/ernie-5.5-flash-preview:free":60000,"deepseek-flash":240000,"nvidia/nemotron-3.5-super-vl:free":60000,"sensenova-6.8-flash-lite":60000,"nvidia/nemotron-3.5-lightning:free":60000,"sensenova-6.8-flash":60000}

# ── OpenRouter（当前任务首选）──
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# ── SenseNova / Token Plan（交错降级）──
SENSENOVA_API_KEY=sk-xxxxxxxxxxxxxxxx
SENSENOVA_BASE_URL=https://api.sensenova.cn/compatible-mode/v2
SENSENOVA_MODEL=deepseek-flash
# 显式链中的 SenseNova 模型统一走 Token Plan。
SENSENOVA_FALLBACK_BASE_URL=https://token.sensenova.cn/v1
# 留空则复用 SENSENOVA_API_KEY；CI 中注入 SENSENOVA_TP_API_KEY。
SENSENOVA_FALLBACK_API_KEY=

# 不设置 AI_FALLBACK_CHAIN 时，可使用供应商内编号降级：
# SENSENOVA_FALLBACK_MODEL=sensenova-6.8-flash-lite
# SENSENOVA_FALLBACK_MODEL_2=sensenova-6.8-flash
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_FALLBACK_MODEL_2=nvidia/nemotron-3.5-lightning:free

# ── Groq（可选降级供应商）──
# GROQ_API_KEY=gsk_xxxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=moonshotai/kimi-k2-instruct-0905

# ── 硅基流动（可选）─────────────────────────────
# SILICONFLOW_API_KEY=sk-xxxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=tencent/Hunyuan-MT-7B

# ── SenseNova Token Plan 端点 ───────────────────
SENSENOVA_TP_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_TP_API_KEY=

# ── 自定义供应商示例 ──
# 在 AI_PROVIDER_CHAIN 中追加前缀名即可
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_NAME=DeepSeek

# =================================================================
# 3. 飞书消息推送配置
# =================================================================
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...
FEISHU_USER_ID=ou_...

# Webhook 卡片底部诊断信息开关（调试阶段 = true，生产 = false）
#   true  → 卡片底部追加 LLM 调用次数 / Token 用量 / finish_reason / 截断告警
#   false → 干净卡片（推送给最终用户的样子）
DEBUG_WEBHOOK=true

# =================================================================
# 4. 运行参数
# =================================================================
OUTPUT_DIR=./output
LANGUAGE=zh-CN
TWEETS_PER_ACCOUNT=30
HOURS_LOOKBACK=72
CACHE_RETENTION_HOURS=720
ACCOUNT_SCAN_INTERVAL=12
# 单批次推文数（翻译任务；免费模型建议 10-15，避免触发 RPM 限制）
AI_BATCH_SIZE=15
# 批次间冷却秒数（防限流）
AI_BATCH_COOLDOWN=15
# 单批次最大条目数上限（防止输出 token 截断）
AI_MAX_BATCH_SIZE=30
# 洞察任务批次大小；与具体模型的上下文和输出上限配合调整。
AI_BATCH_SIZE_TP=30
