# =================================================================
# 1. 基础网络配置 (国内访问必填)
# =================================================================
# 保障爬虫访问 x.com 及调用海外 API 端点
# 注意：端口号 (如 8118, 7890, 1080) 需根据您本地代理软件的实际设置修改
PROXY=http://127.0.0.1:7897

# =================================================================
# 2. AI 供应商降级链
# =================================================================
# 逗号分隔供应商前缀，第一个为主模型，调整顺序即改优先级
# 新增供应商只需：1. 加入此列表  2. 配置 {前缀}_API_KEY / _BASE_URL / _MODEL
#
# 推荐配置（SenseNova 优先 — 国内稳定、DeepSeek 全系免费至 2026-08-09）：
#   SENSENOVA,GROQ,OPENROUTER    # 商汤(DeepSeek)主理 → Groq 兜底 → OpenRouter 兜底
AI_PROVIDER_CHAIN=SENSENOVA,GROQ,OPENROUTER

# ── SenseNova / 商汤（首选 — 国内直连，DeepSeek-V3-1 / R1 免费）──
#   文档：/Users/hainingyu/Code/docs/api/sensenova-best-practices.md
#   免费模型清单（限免至 2026-08-09，Distill 系列永久免费）：
#     DeepSeek-V3-1            通用对话 32K    主模型首选
#     DeepSeek-R1              原生推理 8K     强分析、决策
#     DeepSeek-R1-Distill-Qwen-32B  蒸馏推理 8K   永久免费（限免到期后兜底）
#     DeepSeek-R1-Distill-Qwen-14B  蒸馏推理 32K  永久免费
#   速率限制：1 QPS / 6 RPM / 128K TPM — 并行调用极易触发限流
SENSENOVA_API_KEY=sk-xxxxxxxxxxxxxxxx
SENSENOVA_BASE_URL=https://api.sensenova.cn/compatible-mode/v2
SENSENOVA_MODEL=DeepSeek-V3-1
# 本地备选：另一个免费模型（同账号下走不同模型负载）
SENSENOVA_FALLBACK_MODEL=DeepSeek-R1

# ── Groq（降级备选 — 极速推理）──
# GROQ_API_KEY=gsk_xxxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=moonshotai/kimi-k2-instruct-0905
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── OpenRouter（降级备选 — 限免模型聚合平台）──
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODEL=tencent/hy3-preview:free

# ── 硅基流动（可选，翻译专用）─────────────────────────────
#   混元 MT-7B：7B 翻译专用模型，WMT25 30个语言类别第一，限免
# SILICONFLOW_API_KEY=sk-xxxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=tencent/Hunyuan-MT-7B

# ── 任务差异化模型（覆盖主模型，空值则回退到主模型）────────
#   翻译专用：SenseNova DeepSeek-R1-Distill-Qwen-14B
#     - 永久免费，32K 上下文，不受 2026-08-09 限免影响
#     - 术语保留率 67%，优于 V3-1/R1 的 48%（见 tests/test_translate_models.py）
#     - 已知缺陷：不会 SKIP 纯中文/纯表情，会原样返回
AI_MODEL_TRANSLATE=DeepSeek-R1-Distill-Qwen-14B
#   分析与科普专用：SenseNova Token Plan 上的 sensenova-6.7-flash-lite
#     - 256K 上下文，每 5h 1500 次（远比原 1 QPS 宽松）
#     - 失败时自动降级到主链的 V3-1 / R1
AI_MODEL_INSIGHTS=sensenova-6.7-flash-lite

# ── SenseNova Token Plan（洞察任务专用独立端点）──────────
#   文档：docs/api/sensenova-token-plan-usage.md
#   Base URL 与原 api.sensenova.cn 不同：必须用 token.sensenova.cn
#   API Key 留空则自动复用上方 SENSENOVA_API_KEY
SENSENOVA_TP_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_TP_API_KEY=

#   ⚠️ 重要：pipeline/score.py 的双引擎打分仍用 DeepSeek-R1（与 V3-1 配对）
#      那是 R1 的合适用途，单轮评分不受 reasoning_content 往返问题影响

# ── 自定义供应商示例 ──
# 在 AI_PROVIDER_CHAIN 中追加前缀名即可
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_NAME=DeepSeek

# =================================================================
# 3. 飞书消息推送配置
# =================================================================
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...
FEISHU_USER_ID=ou_...

# =================================================================
# 4. 运行参数
# =================================================================
OUTPUT_DIR=./output
LANGUAGE=zh-CN
TWEETS_PER_ACCOUNT=30
HOURS_LOOKBACK=72
CACHE_RETENTION_HOURS=720
ACCOUNT_SCAN_INTERVAL=12
# 单批次推文数（SenseNova 免费模型建议 10-15，避免触发 1 QPS 限流）
AI_BATCH_SIZE=15
# 批次间冷却秒数（防限流）
AI_BATCH_COOLDOWN=15
# 单批次最大条目数上限（防止输出 token 截断）
# SenseNova DeepSeek-V3-1 / R1 上下文 8K-32K，默认 30 即可
AI_MAX_BATCH_SIZE=30
